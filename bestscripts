-- RenderStepped loop
RunService.RenderStepped:Connect(function()
    local mousePos = UIS:GetMouseLocation()
    fovCircle.Position = mousePos
    fovCircle.Radius = cfg.silentAimFOV
    fovCircle.Visible = cfg.silentAimFOVShow
    fovCircle.Transparency = cfg.silentAimFOVOpacity
    
    if cfg.silentAim then
        silentAimCachedPart = getClosestPlayerToCursor()
    else
        silentAimCachedPart = nil
    end

    -- Strict Target Lock death check
    if cfg.strictCamlock and camlockTarget then
        local p = Players:GetPlayerFromCharacter(camlockTarget.Parent)
        if not p or not isAlive(p) then
            camlockTarget = nil
        end
    end

    -- Hitbox Expander loop logic
    if cfg.hitboxExpander then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and isAlive(p) then
                local char = p.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not originalHitboxSizes[hrp] then
                        originalHitboxSizes[hrp] = hrp.Size
                    end
                    if not originalHitboxTransparencies[hrp] then
                        originalHitboxTransparencies[hrp] = hrp.Transparency
                    end
                    hrp.Size = Vector3.new(cfg.hitboxScale, cfg.hitboxScale, cfg.hitboxScale)
                    hrp.Transparency = cfg.hitboxTransparency
                    hrp.CanCollide = false
                end
            end
        end
    end

    -- ESP Rendering Loop
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local char = p.Character
            local head = char and char:FindFirstChild("Head")
            
            -- Username ESP
            if cfg.usernameESP and isAlive(p) and head then
                if not espBillboards[p] then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "DivineESP"
                    bb.Size = UDim2.new(0, 100, 0, 40)
                    bb.StudsOffset = Vector3.new(0, 2.5, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = head
                    
                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Font = Enum.Font.Code
                    txt.TextColor3 = Color3.fromRGB(0, 200, 255)
                    txt.TextSize = 11
                    txt.TextStrokeTransparency = 0.4
                    txt.Text = p.Name
                    txt.Parent = bb
                    
                    espBillboards[p] = bb
                end
            else
                if espBillboards[p] then
                    espBillboards[p]:Destroy()
                    espBillboards[p] = nil
                end
            end

            -- Highlight ESP
            if cfg.highlightESP and isAlive(p) and char then
                if not espHighlights[p] then
                    local hl = Instance.new("Highlight")
                    hl.Name = "DivineHighlight"
                    hl.Adornee = char
                    hl.FillColor = Color3.fromRGB(0, 120, 200)
                    hl.OutlineColor = Color3.fromRGB(0, 200, 255)
                    hl.FillTransparency = 0.6
                    hl.Parent = char
                    
                    espHighlights[p] = hl
                end
            else
                if espHighlights[p] then
                    espHighlights[p]:Destroy()
                    espHighlights[p] = nil
                end
            end
        end
    end

    -- Camlock Logic
    if cfg.camlockMode then
        if not camlockTarget or not cfg.strictCamlock then
            if cfg.camlockSelectedPlayer then
                if isAlive(cfg.camlockSelectedPlayer) then
                    camlockTarget = getTargetPart(cfg.camlockSelectedPlayer.Character)
                else
                    camlockTarget = nil
                end
            else
                camlockTarget = getClosestPlayerForCamlock()
            end
        end

        if camlockTarget then
            local isBehindWall = false
            if cfg.camlockWallCheck then
                isBehindWall = wallBetween(camlockTarget.Position)
            end

            if not isBehindWall then
                local targetPos = camlockTarget.Position
                local hrp = camlockTarget.Parent:FindFirstChild("HumanoidRootPart")
                if hrp and cfg.camlockPrediction > 0 then
                    targetPos = targetPos + (hrp.Velocity * cfg.camlockPrediction)
                end
                
                local currentCFrame = cam.CFrame
                local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
                local smoothness = math.clamp(cfg.camlockSmoothness, 1, 20)
                cam.CFrame = currentCFrame:Lerp(targetCFrame, 1 / smoothness)
            end
        end
    else
        if not cfg.strictCamlock then
            camlockTarget = nil
        end
    end
end)

-- Keybind toggles with debounce protection
local lastKeyToggled = 0
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if tick() - lastKeyToggled < 0.2 then return end
    
    if input.KeyCode == cfg.silentAimKey and cfg.useKeybind then
        lastKeyToggled = tick()
        cfg.silentAim = not cfg.silentAim
        silentAimToggleBtn.Text = "  Silent Aim Mode: " .. (cfg.silentAim and "ENABLED" or "DISABLED")
        sendNotification("Silent Aim Mode", cfg.silentAim)
    elseif input.KeyCode == cfg.camlockKey then
        lastKeyToggled = tick()
        cfg.camlockMode = not cfg.camlockMode
        camlockToggleBtn.Text = "  Camlock Mode: " .. (cfg.camlockMode and "ENABLED" or "DISABLED")
        if not cfg.camlockMode then
            camlockTarget = nil
        end
        sendNotification("Camlock Mode", cfg.camlockMode)
    elseif input.KeyCode == cfg.uiToggleKey then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

-- HOOK METAMETHOD (Ensures Silent Aim actually redirects bullets)
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__index = newcclosure(function(self, key)
    if not checkcaller() and self == mouse and cfg.silentAim and not isHoldingRevolver() then
        if (key == "Hit" or key == "Target" or key == "UnitRay") and silentAimCachedPart then
            if math.random(1, 100) <= cfg.silentAimHitChance then
                local origin = cam.CFrame.Position
                local targetPos = silentAimCachedPart.Position + Vector3.new(
                    silentAimCachedPart.AssemblyLinearVelocity.X * cfg.silentAimPredX,
                    silentAimCachedPart.AssemblyLinearVelocity.Y * cfg.silentAimPredY,
                    silentAimCachedPart.AssemblyLinearVelocity.Z * cfg.silentAimPredZ
                )
                
                if key == "Hit" then
                    return CFrame.new(targetPos)
                elseif key == "Target" then
                    return silentAimCachedPart
                elseif key == "UnitRay" then
                    return Ray.new(origin, (targetPos - origin).Unit)
                end
            end
        end
    end
    return oldIndex(self, key)
end)

setreadonly(mt, true)
