local function refreshPlayerList()
    for _, child in ipairs(playerScrollContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local autoBtn = Instance.new("TextButton")
    autoBtn.Size = UDim2.new(1, 0, 0, 26)
    autoBtn.BackgroundColor3 = (cfg.camlockSelectedPlayer == nil) and Color3.fromRGB(40, 40, 55) or Color3.fromRGB(22, 22, 28)
    autoBtn.Font = Enum.Font.Code
    autoBtn.Text = "  [AUTO] Closest to Cursor"
    autoBtn.TextColor3 = (cfg.camlockSelectedPlayer == nil) and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(150, 150, 165)
    autoBtn.TextSize = 10
    autoBtn.TextXAlignment = Enum.TextXAlignment.Left
    autoBtn.Parent = playerScrollContainer

    autoBtn.MouseButton1Down:Connect(function()
        cfg.camlockSelectedPlayer = nil
        refreshPlayerList()
        sendNotification("Camlock Target", "Auto")
    end)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 26)
            pBtn.BackgroundColor3 = (cfg.camlockSelectedPlayer == p) and Color3.fromRGB(40, 40, 55) or Color3.fromRGB(22, 22, 28)
            pBtn.Font = Enum.Font.Code
            pBtn.Text = "  " .. p.Name .. " (" .. p.DisplayName .. ")"
            pBtn.TextColor3 = (cfg.camlockSelectedPlayer == p) and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(150, 150, 165)
            pBtn.TextSize = 10
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = playerScrollContainer

            pBtn.MouseButton1Down:Connect(function()
                cfg.camlockSelectedPlayer = p
                refreshPlayerList()
                sendNotification("Camlock Target", p.Name)
            end)
        end
    end
    playerScrollContainer.CanvasSize = UDim2.new(0, 0, 0, (#Players:GetPlayers()) * 26)
end

