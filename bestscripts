-- FOG OVERRIDE
local storedEffects = {}
local function updateFog()
    if cfg.noFog then
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 9e9
        Lighting.GlobalShadows = false
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Atmosphere") or obj:IsA("BlurEffect") or obj:IsA("DepthOfFieldEffect") or obj:IsA("SunRaysEffect") then
                if not storedEffects[obj] then storedEffects[obj] = obj.Parent end
                obj.Parent = nil
            end
        end
    else
        Lighting.FogEnd = cfg.fogDistance
        Lighting.FogStart = 0
        Lighting.GlobalShadows = true
        for obj, originalParent in pairs(storedEffects) do
            if obj and originalParent then obj.Parent = originalParent end
        end
        storedEffects = {}
    end
end

